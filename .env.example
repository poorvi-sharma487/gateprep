# GATEPrep environment configuration
PORT=3000
SESSION_SECRET=your_minimum_32_characters_secret_here

# SQLite Database (Recommended default - no server setup needed)
DATABASE_URL=sqlite:./db/gateprep.sqlite
DB_CLIENT=sqlite

# Optional: PostgreSQL (if you want to use external postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/gateprep

# NVIDIA Nemotron AI Integration (Free GATE PYQ Generator & Doubt Solver)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
